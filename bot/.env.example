# Required
TELEGRAM_TOKEN=7123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Protects /api/* endpoints used by the web app.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBAPP_SECRET=your-random-secret-here

# Sent to Telegram by /setup-webhook; Telegram echoes it on every update so forged
# webhook calls are rejected. Letters, digits, _ and - only (1-256 chars).
WEBHOOK_SECRET=another-random-secret-here

# Optional
PORT=3000
DATA_DIR=/tmp/nc_data
